    { "id": "OLS-T-001", "stem": "What is the doctrine of stare decisis?", "options": ["Verbal contracts only", "Court binds itself by past decisions", "Punitive damages", "Reverse jurisdiction"], "answer_index": 1, "category": "principles", "difficulty": "L3" },
    { "id": "OLS-T-002", "stem": "An offer becomes a contract when:", "options": ["Made", "Considered", "Accepted unequivocally with consideration", "Posted online"], "answer_index": 2, "category": "contracts", "difficulty": "L3" },
    { "id": "OLS-T-003", "stem": "Limitation period for filing a typical civil tort claim in PK?", "options": ["1 year", "3 years", "12 years", "20 years"], "answer_index": 1, "category": "civil_law_pk", "difficulty": "L4" },
    { "id": "OLS-T-004", "stem": "Burden of proof in criminal cases:", "options": ["Preponderance of evidence", "Beyond reasonable doubt", "Balance of probabilities", "Clear and convincing"], "answer_index": 1, "category": "criminal_law", "difficulty": "L2" },
    { "id": "OLS-T-005", "stem": "Attorney-client privilege does NOT cover:", "options": ["Past wrongdoing disclosed in confidence", "Future planned crime", "Strategic discussions", "Settlement negotiations"], "answer_index": 1, "category": "ethics", "difficulty": "L4" },
    { "id": "OLS-T-006", "stem": "A contract may be rescinded for:", "options": ["Buyer's mood", "Material misrepresentation", "Slight error", "Late delivery by 1 day"], "answer_index": 1, "category": "contracts", "difficulty": "L4" },
    { "id": "OLS-T-007", "stem": "Force majeure clauses require:", "options": ["Verbal mention", "Specific listed events + impossibility/frustration of purpose", "All possible events listed", "Court approval"], "answer_index": 1, "category": "contracts", "difficulty": "L5" },
    { "id": "OLS-T-008", "stem": "Conflict of interest in legal practice means:", "options": ["Two clients with opposing positions", "Two cases at once", "Clients in different industries", "International clients"], "answer_index": 0, "category": "ethics", "difficulty": "L3" },
    { "id": "OLS-T-009", "stem": "A will must typically have:", "options": ["Verbal record only", "Testator signature + 2 witnesses", "Court certificate at signing", "Notary only"], "answer_index": 1, "category": "wills", "difficulty": "L4" },
    { "id": "OLS-T-010", "stem": "GDPR/PDPL principles include:", "options": ["Data maximisation", "Purpose limitation", "Indefinite retention", "No consent needed"], "answer_index": 1, "category": "data_law", "difficulty": "L5" }
