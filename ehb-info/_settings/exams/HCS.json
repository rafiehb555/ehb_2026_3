{
  "industry": "HCS",
  "name": "Health & Compliance",
  "version": "1.0",
  "passing_criteria": { "theory_min_pct": 75, "practical_min_pct": 80, "overall_min_pct": 80 },
  "validity_months": 12,

  "theory_mcqs": [
    { "id": "HCS-T-001", "stem": "GMP stands for:", "options": ["General Marketing Practice", "Good Manufacturing Practice", "Group Management Plan", "Government Mandated Procedure"], "answer_index": 1, "category": "regulatory", "difficulty": "L3" },
    { "id": "HCS-T-002", "stem": "HACCP focuses on:", "options": ["Marketing", "Food safety hazard analysis + critical control points", "Tax compliance", "Worker training only"], "answer_index": 1, "category": "food_safety", "difficulty": "L4" },
    { "id": "HCS-T-003", "stem": "Adverse event reporting timeline (serious case):", "options": ["1 year", "Quarterly", "15 days or less per FDA/EMA", "When convenient"], "answer_index": 2, "category": "pharmacovigilance", "difficulty": "L5" },
    { "id": "HCS-T-004", "stem": "ISO 9001 audits primarily address:", "options": ["Financial", "Quality management system", "HR only", "Marketing"], "answer_index": 1, "category": "audit", "difficulty": "L3" },
    { "id": "HCS-T-005", "stem": "Cleanroom Class A particles (≥0.5μm) max per cubic meter:", "options": ["10,000", "3,520 (in operation)", "100,000", "1,000,000"], "answer_index": 1, "category": "cleanroom", "difficulty": "L7" },
    { "id": "HCS-T-006", "stem": "Hazardous waste disposal requires:", "options": ["Local landfill", "Specialised licensed handler + manifest", "Recycle bin", "Sale"], "answer_index": 1, "category": "waste", "difficulty": "L4" },
    { "id": "HCS-T-007", "stem": "Validation = ?", "options": ["Marketing claim", "Documented evidence that process consistently produces specified outcome", "Approval signature", "Lab certificate"], "answer_index": 1, "category": "validation", "difficulty": "L5" },
    { "id": "HCS-T-008", "stem": "Audit non-conformance categories include:", "options": ["Major / Minor / Observation", "Single category only", "Pass / Fail only", "Auditor's discretion"], "answer_index": 0, "category": "audit", "difficulty": "L4" },
    { "id": "HCS-T-009", "stem": "Pharmacovigilance ICSR is:", "options": ["Inventory record", "Individual Case Safety Report", "Insurance claim", "Inspection log"], "answer_index": 1, "category": "pharmacovigilance", "difficulty": "L5" },
    { "id": "HCS-T-010", "stem": "CAPA process steps:", "options": ["Audit only", "Identify → investigate → corrective action → preventive action → verify", "Penalty", "Restart"], "answer_index": 1, "category": "quality", "difficulty": "L4" }
  ],

  "practical_tasks": [
    { "id": "HCS-P-001", "title": "Audit report", "scenario": "Conduct mock audit of a small pharma manufacturer. Document findings + recommendations.", "deliverables": ["Audit report", "Non-conformance log", "CAPA plan"], "evaluation_rubric": [{"criterion":"Findings depth","weight":35},{"criterion":"Documentation","weight":30},{"criterion":"CAPA quality","weight":35}], "time_limit_hours": 5, "min_pass_score": 80 },
    { "id": "HCS-P-002", "title": "HACCP plan for restaurant", "scenario": "Build HACCP plan for a 50-cover restaurant. Identify hazards, CCPs, controls.", "deliverables": ["HACCP plan", "CCP monitoring forms", "Training plan"], "evaluation_rubric": [{"criterion":"Hazard identification","weight":35},{"criterion":"CCP determination","weight":35},{"criterion":"Practical control","weight":30}], "time_limit_hours": 4, "min_pass_score": 80 },
    { "id": "HCS-P-003", "title": "Validation protocol", "scenario": "Write validation protocol for a new sterilisation process.", "deliverables": ["IQ/OQ/PQ protocol", "Acceptance criteria", "Test plan"], "evaluation_rubric": [{"criterion":"Protocol completeness","weight":35},{"criterion":"Criteria clarity","weight":30},{"criterion":"Test logic","weight":35}], "time_limit_hours": 6, "min_pass_score": 85 },
    { "id": "HCS-P-004", "title": "Adverse event handling", "scenario": "Process 3 adverse event reports; classify, investigate, report per timelines.", "deliverables": ["Per-case ICSR", "Investigation summary", "Reporting log"], "evaluation_rubric": [{"criterion":"Classification","weight":35},{"criterion":"Investigation","weight":35},{"criterion":"Compliance","weight":30}], "time_limit_hours": 3, "min_pass_score": 85 },
    { "id": "HCS-P-005", "title": "Compliance training delivery", "scenario": "Develop and deliver 30-min training on data integrity (ALCOA+) for staff.", "deliverables": ["Training slides", "Recorded delivery", "Quiz with answers"], "evaluation_rubric": [{"criterion":"Content accuracy","weight":30},{"criterion":"Delivery quality","weight":35},{"criterion":"Quiz design","weight":35}], "time_limit_hours": 4, "min_pass_score": 80 }
  ]
}
