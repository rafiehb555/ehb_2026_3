# EHB Web (Next.js) — Production Dockerfile
# Multi-stage build using Next.js standalone output for minimal image
# Build:  docker build -f Dockerfile.web -t ehb/web:v3.11 .
# Run:    docker run -p 3000:3000 --env-file .env ehb/web:v3.11

# ── Stage 1: install deps ──────────────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY apps/web/package.json ./apps/web/
COPY packages ./packages
RUN npm install -g pnpm@8 && pnpm install --frozen-lockfile --prod=false

# ── Stage 2: build ──────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY apps/web ./apps/web
COPY packages ./packages
COPY tsconfig.base.json ./
COPY pnpm-workspace.yaml package.json ./

# Public build-time env (NEXT_PUBLIC_*)
ARG NEXT_PUBLIC_API_URL=http://localhost:5000
ARG NEXT_PUBLIC_AI_URL=http://localhost:8080
ARG NEXT_PUBLIC_DEFAULT_COUNTRY=PK
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_AI_URL=$NEXT_PUBLIC_AI_URL
ENV NEXT_PUBLIC_DEFAULT_COUNTRY=$NEXT_PUBLIC_DEFAULT_COUNTRY

WORKDIR /app/apps/web
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm install -g pnpm@8 && pnpm build

# ── Stage 3: runtime ────────────────────────────────────────────────────────
FROM node:20-alpine AS runtime
RUN apk add --no-cache tini curl
WORKDIR /app

RUN addgroup -g 1001 -S ehb && adduser -S ehb -u 1001 -G ehb

# Next.js standalone output (set in next.config.js)
COPY --from=build --chown=ehb:ehb /app/apps/web/.next/standalone ./
COPY --from=build --chown=ehb:ehb /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=ehb:ehb /app/apps/web/public ./apps/web/public

USER ehb
EXPOSE 3000
ENV NODE_ENV=production
ENV WEB_PORT=3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:3000/api/health || curl -f http://localhost:3000/ || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/web/server.js"]
