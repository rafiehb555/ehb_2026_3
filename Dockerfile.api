# EHB API — Production Dockerfile
# Multi-stage build for minimal image size
# Build:  docker build -f Dockerfile.api -t ehb/api:v3.11 .
# Run:    docker run -p 5000:5000 --env-file .env ehb/api:v3.11

# ── Stage 1: install deps ──────────────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat python3 make g++
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY services/api/package.json ./services/api/
RUN npm install -g pnpm@8 && pnpm install --frozen-lockfile --prod=false

# ── Stage 2: build ──────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/services/api/node_modules ./services/api/node_modules
COPY services/api ./services/api
COPY packages ./packages
COPY tsconfig.base.json ./
WORKDIR /app/services/api
# No build step needed for pure JS — but if TS, run: RUN pnpm build

# ── Stage 3: runtime ────────────────────────────────────────────────────────
FROM node:20-alpine AS runtime
RUN apk add --no-cache tini curl
WORKDIR /app

# Non-root user
RUN addgroup -g 1001 -S ehb && adduser -S ehb -u 1001 -G ehb

# Copy only what's needed at runtime
COPY --from=build --chown=ehb:ehb /app/services/api ./services/api
COPY --from=build --chown=ehb:ehb /app/node_modules ./node_modules
COPY --from=build --chown=ehb:ehb /app/services/api/node_modules ./services/api/node_modules
COPY --from=build --chown=ehb:ehb /app/packages ./packages

USER ehb
WORKDIR /app/services/api

EXPOSE 5000
ENV NODE_ENV=production
ENV API_PORT=5000

# Healthcheck — every 30s, fail after 3 attempts
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:5000/api/health || exit 1

# Tini handles SIGTERM gracefully
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "src/index.js"]
