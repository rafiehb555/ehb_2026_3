# EHB Development 2026 — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# Updated: 2026-04-27 · Affiliate v3.11

# ════════════════════════════════════════════════════════════════════════════
# CORE
# ════════════════════════════════════════════════════════════════════════════

NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Karachi

# Ports
API_PORT=5000
AI_PORT=8080
WEB_PORT=3000

# ════════════════════════════════════════════════════════════════════════════
# DATABASE
# ════════════════════════════════════════════════════════════════════════════

MONGODB_URI=mongodb://localhost:27017/ehb_dev
MONGO_REPLICA_SET=                     # leave empty for standalone
MONGO_READ_PREFERENCE=primary

# PostgreSQL (financial ledger — Phase 2)
POSTGRES_URL=

# Redis (cache + rate limiting)
REDIS_URL=redis://localhost:6379

# ════════════════════════════════════════════════════════════════════════════
# AUTHENTICATION & SECURITY
# ════════════════════════════════════════════════════════════════════════════

JWT_SECRET=replace-with-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
SESSION_SECRET=replace-with-different-32-char-string
BCRYPT_ROUNDS=12

# 2FA
TOTP_ISSUER=EHB
TWILIO_ACCOUNT_SID=                    # SMS 2FA
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Velocity caps (per Affiliate.md §13.1.3 #4)
VELOCITY_SIGNUPS_PER_IP_24H=50
VELOCITY_SIGNUPS_PER_DEVICE_24H=10
VELOCITY_FLAG_USD_7D=50000

# ════════════════════════════════════════════════════════════════════════════
# SERVICE URLs (frontend ↔ backend)
# ════════════════════════════════════════════════════════════════════════════

NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_AI_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:5000
NEXT_PUBLIC_DEFAULT_COUNTRY=PK
NEXT_PUBLIC_DEFAULT_LANG=en
API_SERVICE_URL=http://localhost:5000
AI_SERVICE_URL=http://localhost:8080

# ════════════════════════════════════════════════════════════════════════════
# AFFILIATE PROGRAM v3.2 RULES (admin-tunable in DB; env = defaults)
# ════════════════════════════════════════════════════════════════════════════

# Track A — Product affiliate
AFFILIATE_TRACK_A_NETWORK_POOL_PCT=5
AFFILIATE_TRACK_A_L1_PCT=3
AFFILIATE_TRACK_A_L2_PCT=1.5
AFFILIATE_TRACK_A_L3_PCT=0.5

# Bonuses (per §12.7)
AFFILIATE_FIRST_SALE_BONUS_USD=5
AFFILIATE_FAST_SALE_TRIGGER_COUNT=4
AFFILIATE_FAST_SALE_WEEKLY_FREE_CAP=2

# Capping (per §13.2)
AFFILIATE_R1_DAILY_CAP_USD=100
AFFILIATE_R5_DAILY_CAP_USD=1000
AFFILIATE_R10_DAILY_CAP_USD=50000
AFFILIATE_PER_TX_CAP_USD=10000
AFFILIATE_GLOBAL_DAILY_CAP_PCT_REVENUE=5

# Compliance windows
AFFILIATE_COOLING_OFF_DAYS=30
AFFILIATE_REFUND_WINDOW_DAYS=90
AFFILIATE_INACTIVE_FRANCHISE_GRACE_DAYS=30

# Country pilot (per §13.3.5)
AFFILIATE_PILOT_COUNTRY=PK
AFFILIATE_LIVE_COUNTRIES=PK            # comma-separated; AE,IN,UK,US in Phase 2

# ════════════════════════════════════════════════════════════════════════════
# BANK RAILS — Pakistan pilot (per §13.6.4)
# ════════════════════════════════════════════════════════════════════════════

# JazzCash (sandbox by default)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_API_URL=https://sandbox.jazzcash.com.pk
JAZZCASH_RETURN_URL=https://api.ehb.com/api/wallet/jazzcash/callback

# HBL Bank
HBL_API_KEY=
HBL_MERCHANT_ID=
HBL_API_URL=https://api.hbl.com/api/v1
HBL_WEBHOOK_SECRET=

# Phase 2 banks
EMIRATES_NBD_API_KEY=                  # UAE
PLAID_CLIENT_ID=                       # USA
PLAID_SECRET=
RAZORPAY_KEY_ID=                       # India
RAZORPAY_KEY_SECRET=
OPEN_BANKING_CLIENT_ID=                # UK

# ════════════════════════════════════════════════════════════════════════════
# USDT / CRYPTO (per §13.6.5)
# ════════════════════════════════════════════════════════════════════════════

# Tron (TRC20 default — $1 fee)
TRON_NETWORK=mainnet                   # 'shasta' for testnet
TRON_PRIVATE_KEY_HOT=                  # ≤5% of custody
TRON_PRIVATE_KEY_WARM=                 # ≤20%, 1h delay
TRON_PRIVATE_KEY_COLD=                 # ≥75%, 24h delay
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# Ethereum (ERC20)
ETH_RPC_URL=
ETH_USDT_CONTRACT=0xdac17f958d2ee523a2206206994597c13d831ec7
ETH_PRIVATE_KEY_HOT=

# BSC (BEP20)
BSC_RPC_URL=
BSC_USDT_CONTRACT=0x55d398326f99059ff775485246999027b3197955

# Multi-sig
COLD_WALLET_MULTISIG_THRESHOLD=5       # 5-of-9 board signatures
COLD_WALLET_DELAY_HOURS=24

# ════════════════════════════════════════════════════════════════════════════
# KYC / AML VENDORS (per §13.6.6, adapter pattern)
# ════════════════════════════════════════════════════════════════════════════

KYC_DEFAULT_VENDOR=nadra               # nadra | jumio | onfido

# Pakistan — NADRA
NADRA_API_KEY=
NADRA_API_URL=https://verify.nadra.gov.pk/api/v1

# Global — Jumio
JUMIO_API_TOKEN=
JUMIO_API_SECRET=
JUMIO_API_URL=https://netverify.com/api/v4

# Global — Onfido
ONFIDO_API_TOKEN=
ONFIDO_API_REGION=eu                   # eu | us | ca

# AML / Sanctions
COMPLY_ADVANTAGE_API_KEY=
REFINITIV_API_KEY=
OFAC_LIST_URL=https://www.treasury.gov/ofac/downloads/sdn.xml
OFAC_REFRESH_INTERVAL_HOURS=24

# ════════════════════════════════════════════════════════════════════════════
# EMAIL & NOTIFICATIONS
# ════════════════════════════════════════════════════════════════════════════

EMAIL_PROVIDER=ses                     # ses | sendgrid | mailgun | smtp

# AWS SES
AWS_SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM_ADDRESS=noreply@ehb.com
EMAIL_FROM_NAME="EHB Affiliate"
EMAIL_REPLY_TO=support@ehb.com

# SendGrid (alt)
SENDGRID_API_KEY=

# In-app
WEBHOOK_SECRET=                        # for inbound webhook verification
SOCKET_IO_SECRET=

# Push (mobile — Phase 2)
FIREBASE_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=

# ════════════════════════════════════════════════════════════════════════════
# AI MODEL (per §13.4)
# ════════════════════════════════════════════════════════════════════════════

OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL_DEFAULT=gpt-3.5-turbo
OPENAI_MODEL_PREMIUM=gpt-4
OPENAI_FRAUD_MODEL_ID=                 # custom fine-tuned

# ════════════════════════════════════════════════════════════════════════════
# BLOCKCHAIN (Phase 2/3)
# ════════════════════════════════════════════════════════════════════════════

POLKADOT_RPC_WS=wss://rpc.polkadot.io
POLKADOT_PARACHAIN_ID=
POLKADOT_ACCOUNT_SEED=
ANCHOR_BATCH_SIZE=100
ANCHOR_INTERVAL_MINUTES=10

# Chainlink price oracle
CHAINLINK_PRICE_FEED_USDT_USD=

# ════════════════════════════════════════════════════════════════════════════
# CDN, STORAGE, REGION
# ════════════════════════════════════════════════════════════════════════════

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CDN_BASE_URL=https://cdn.ehb.com

S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_BUCKET_KYC=ehb-kyc-documents-encrypted
S3_BUCKET_PROMO=ehb-promo-materials
S3_KMS_KEY_ID=

DEPLOY_REGION=ap-southeast-1           # Singapore (single-region launch)
BACKUP_REGION=eu-central-1             # Frankfurt (Phase 2)
DR_REGION=us-east-1                    # Virginia (Phase 2)

# ════════════════════════════════════════════════════════════════════════════
# OBSERVABILITY
# ════════════════════════════════════════════════════════════════════════════

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=ehb-api
PROMETHEUS_METRICS_PORT=9090
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=v3.11
LOKI_URL=http://localhost:3100
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# ════════════════════════════════════════════════════════════════════════════
# RATE LIMITING & WITHDRAWAL POLICY
# ════════════════════════════════════════════════════════════════════════════

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_PER_MIN=60
RATE_LIMIT_AUTH_PER_MIN=300
RATE_LIMIT_ADMIN_PER_MIN=600
WITHDRAWAL_DAILY_LIMIT_DEFAULT=3
WITHDRAWAL_HOURLY_COOLDOWN=1
NEW_WHITELIST_ADDRESS_HOLD_HOURS=24

# ════════════════════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ════════════════════════════════════════════════════════════════════════════

BLOCKCHAIN_ENABLED=false
PAYMENT_GATEWAY_ENABLED=false
FEATURE_AFFILIATE_TRACK_B=true
FEATURE_AFFILIATE_BONUSES_V3=true
FEATURE_AFFILIATE_DYNAMIC_PRICING=false # Phase 2
FEATURE_USDT_WITHDRAWALS=true
FEATURE_BANK_WITHDRAWALS=true          # PK only at launch
FEATURE_REAL_TIME_ANALYTICS=false      # Phase 9 (Kafka)
FEATURE_KAFKA_EVENTS=false             # Phase 9

# Phase 1 demo seed
SEED_DEMO_DATA=true
AI_FREE_DAILY_QUOTA=3
FRANCHISE_DEFAULT_COUNTRY=PK
FRANCHISE_CURRENT_ROUND=1
FRANCHISE_CURRENT_PHASE=1

# ════════════════════════════════════════════════════════════════════════════
# DEVELOPMENT-ONLY (do NOT use in production)
# ════════════════════════════════════════════════════════════════════════════

DEV_SKIP_KYC=false                     # bypass KYC in dev
DEV_SKIP_OFAC=false                    # bypass OFAC in dev
DEV_SEED_AFFILIATE_DEMO=true           # populate fake affiliates
DEV_AUTO_PROMOTE_RANK=false            # auto-promote without meeting reqs
